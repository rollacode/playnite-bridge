<UserControl x:Class="PlayniteBridge.Settings.PluginSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Margin="0">

    <UserControl.Resources>
        <Style TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}" />

        <Style x:Key="SectionHeader" TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
            <Setter Property="FontSize" Value="{DynamicResource FontSizeLarger}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource GlyphBrush}"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style x:Key="SubHeader" TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
            <Setter Property="FontSize" Value="{DynamicResource FontSizeLarge}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Margin" Value="0,4,0,6"/>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
            <Setter Property="Foreground" Value="{DynamicResource TextBrushDarker}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="MinWidth" Value="90"/>
        </Style>

        <Style x:Key="StatusGreen" TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
            <Setter Property="Foreground" Value="{DynamicResource PositiveRatingBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="MonoText" TargetType="TextBox">
            <Setter Property="FontFamily" Value="{DynamicResource MonospaceFontFamily}"/>
            <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource NormalBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
        </Style>

        <Style x:Key="MonoBlock" TargetType="TextBox" BasedOn="{StaticResource MonoText}">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="MaxHeight" Value="140"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="4">

            <!-- API Status -->
            <Border BorderThickness="3,0,0,0" BorderBrush="{DynamicResource GlyphBrush}"
                    Padding="16,10,0,10" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionHeader}" Text="API Status"/>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Status:"/>
                        <TextBlock Grid.Column="1" x:Name="StatusText" Style="{StaticResource StatusGreen}"/>
                    </Grid>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Network:"/>
                        <TextBlock Grid.Column="1" x:Name="NetworkText" Style="{StaticResource StatusGreen}"/>
                    </Grid>

                    <Button x:Name="BtnEnableNetwork" Content="Enable Network Access"
                            HorizontalAlignment="Left" Margin="0,2,0,12"
                            Padding="12,5" Click="BtnEnableNetwork_Click"/>

                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Token:"/>
                        <TextBox Grid.Column="1" x:Name="TokenBox" Style="{StaticResource MonoText}" Margin="0,0,8,0"/>
                        <Button Grid.Column="2" x:Name="BtnCopyToken" Content="Copy"
                                Padding="12,5" Click="BtnCopyToken_Click"/>
                    </Grid>

                    <Button x:Name="BtnRegenerateToken" Content="Regenerate Token"
                            HorizontalAlignment="Left" Margin="0,8,0,0"
                            Padding="12,5" Click="BtnRegenerateToken_Click"/>
                </StackPanel>
            </Border>

            <!-- AI Integration -->
            <Border BorderThickness="3,0,0,0" BorderBrush="{DynamicResource HighlightGlyphBrush}"
                    Padding="16,10,0,10" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionHeader}" Text="AI Integration"/>

                    <TextBlock Text="Paste the AI Skill into any AI chat (Claude, ChatGPT, Gemini):"
                               TextWrapping="Wrap" Margin="0,0,0,8"
                               Foreground="{DynamicResource TextBrushDarker}"/>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Button x:Name="BtnCopySkill" Content="Copy AI Skill"
                                Padding="14,6" Click="BtnCopySkill_Click"/>
                        <Button x:Name="BtnOpenSkillFile" Content="Open as File"
                                Padding="14,6" Margin="8,0,0,0" Click="BtnOpenSkillFile_Click"/>
                    </StackPanel>

                    <Separator Background="{DynamicResource PanelSeparatorBrush}" Margin="0,0,0,16"/>

                    <!-- Claude Desktop -->
                    <TextBlock Style="{StaticResource SubHeader}" Text="Claude Desktop (MCP)"/>
                    <TextBlock Text="Add to claude_desktop_config.json (Settings → Developer → Edit Config):"
                               TextWrapping="Wrap" Margin="0,0,0,6"
                               Foreground="{DynamicResource TextBrushDarker}"/>
                    <TextBox x:Name="ClaudeConfigBox" Style="{StaticResource MonoBlock}"/>
                    <Button x:Name="BtnCopyClaudeConfig" Content="Copy Config"
                            HorizontalAlignment="Left" Padding="12,5"
                            Margin="0,6,0,16" Click="BtnCopyClaudeConfig_Click"/>

                    <Separator Background="{DynamicResource PanelSeparatorBrush}" Margin="0,0,0,16"/>

                    <!-- ChatGPT -->
                    <TextBlock Style="{StaticResource SubHeader}" Text="ChatGPT / OpenAI"/>
                    <TextBlock Text="MCP server URL (start server first: cd mcp &amp;&amp; npm start):"
                               TextWrapping="Wrap" Margin="0,0,0,6"
                               Foreground="{DynamicResource TextBrushDarker}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" x:Name="ChatGptUrlBox" Style="{StaticResource MonoText}" Margin="0,0,8,0"/>
                        <Button Grid.Column="1" x:Name="BtnCopyChatGptUrl" Content="Copy"
                                Padding="12,5" Click="BtnCopyChatGptUrl_Click"/>
                    </Grid>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
